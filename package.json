{
  "name": "demoblaze-e2e",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E automation framework for https://www.demoblaze.com (UI, API, regression, performance)",
  "private": true,
  "scripts": {
    "test": "playwright test --grep-invert @perf",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:perf": "playwright test --project=perf",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:demo": "playwright test tests/ui/checkout.spec.ts --project=chromium --headed",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "browsers:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
