# Copy to .env (or .env.<TEST_ENV>) and adjust. Every value is optional.

# Which env file to load on top of .env, e.g. TEST_ENV=staging loads .env.staging
TEST_ENV=prod

# Application under test
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# Optional pre-existing account. When empty, the framework registers a fresh
# unique user through the API for every test (fully isolated, recommended).
TEST_USERNAME=
TEST_PASSWORD=

# Execution
HEADLESS=true

# Parallel workers. `npm test` sets this per stage and ignores the value here.
# It applies to `npm run test:single` and the per-project scripts: 4 locally
# (capped by half the cores), 2 on CI. WebKit degrades sharply above ~6 on
# Windows, so raise it only if you accept flaky WebKit outliers.
WORKERS=
RETRIES=
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000

# Artifacts: off | on | retain-on-failure | on-first-retry
# Video defaults to off locally and retain-on-failure on CI; traces are
# retain-on-failure everywhere.
VIDEO=
TRACE=

# Performance budgets (ms)
PERF_PAGE_LOAD_BUDGET_MS=8000
PERF_API_BUDGET_MS=3000
PERF_API_SAMPLES=5
# Page metrics are asserted on the median of this many samples, because one
# slow load on a shared demo site is noise, not a regression.
PERF_PAGE_SAMPLES=3
